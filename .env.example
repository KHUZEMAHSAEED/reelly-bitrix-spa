# ==============================================================================
# Reelly API Configuration
# ==============================================================================
REELLY_API_BASE_URL=https://api-reelly.up.railway.app/api/v2/clients
REELLY_API_KEY=your_reelly_api_key_here
REELLY_AUTH_HEADER=X-API-Key
REELLY_PAGE_SIZE=20
REELLY_TIMEOUT=30
REELLY_MAX_RETRIES=3

# ==============================================================================
# Bitrix24 Configuration
# ==============================================================================
# Inbound Webhook URL from Bitrix24 (CRM scope and permission to manage SPA fields required)
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your_webhook_token/
# Entity Type ID for the Smart Process Automation (e.g. 1032)
BITRIX_SPA_ENTITY_TYPE_ID=1032
# Default stage for newly synced listings (e.g. DT1032_NEW, NEW)
BITRIX_STAGE_ACTIVE=DT1032_NEW
# Stage/status assigned to listings no longer active or absent from Reelly
BITRIX_STAGE_REMOVED=DT1032_FAIL
# Default user ID to assign listings to in Bitrix24
BITRIX_ASSIGNED_BY_ID=1
# Request throttling (stay under Bitrix rate limit of ~2 requests/second)
BITRIX_RATE_LIMIT_DELAY_MS=500
BITRIX_TIMEOUT=60
BITRIX_MAX_RETRIES=5

# ==============================================================================
# AWS S3 Configuration (Image Archival & CDN)
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-property-listings-bucket
# Optional custom S3 endpoint (e.g. for MinIO, Wasabi, or LocalStack)
AWS_ENDPOINT=
# Optional public CDN base URL (if different from default S3 bucket URL)
S3_PUBLIC_BASE_URL=

# Image Processing Controls
MAX_IMAGES_PER_LISTING=10
IMAGE_MAX_WIDTH=1600
IMAGE_JPEG_QUALITY=85
IMAGE_DOWNLOAD_TIMEOUT=15
IMAGE_MAX_FILE_SIZE_BYTES=10485760

# ==============================================================================
# Sync & Safety Guardrails
# ==============================================================================
# Maximum percentage of listings that can be marked removed in a single run (safety abort)
REMOVAL_THRESHOLD_PERCENT=20
LOG_LEVEL=INFO

