{
    "name": "reelly/bitrix-spa-sync",
    "description": "Sync property listings from Reelly API into Bitrix24 Smart Process Automation (SPA)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-gd": "*",
        "guzzlehttp/guzzle": "^7.8",
        "aws/aws-sdk-php": "^3.300",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

